# Required
OPENSEA_API_KEY=YOUR_OPENSEA_API_KEY
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Optional extra keys for REST resilience. Same-account keys share one OpenSea rate-limit bucket.
OPENSEA_API_KEY_2=
OPENSEA_API_KEY_3=
OPENSEA_API_KEY_4=
OPENSEA_API_KEY_5=

# Alert rules — applied globally to every collection seen by OpenSea Stream
SALES_PER_MINUTE=5
VOLUME_THRESHOLD_USD=1000
MAX_VOLUME_WINDOW_MINUTES=30

# Supply: NO collection cap. Every OpenSea mint-like transfer queues the collection.
# Collections are verified in batches to stay within OpenSea REST limits.
SUPPLY_BATCH_SIZE=50
SUPPLY_BATCH_INTERVAL_SECONDS=10
SUPPLY_RECHECK_DELAY_SECONDS=20

# Enrichment caches
PRICE_CACHE_MINUTES=10
COLLECTION_CACHE_MINUTES=30
STATS_CACHE_SECONDS=120

# Cooldowns
VOLUME_ALERT_COOLDOWN_SECONDS=3600
SUPPLY_ALERT_COOLDOWN_SECONDS=1800

PORT=10000
