# Required
OPENSEA_API_KEY=YOUR_OPENSEA_API_KEY
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Optional extra keys for REST resilience. Same-account keys share the same OpenSea rate-limit bucket.
OPENSEA_API_KEY_2=
OPENSEA_API_KEY_3=
OPENSEA_API_KEY_4=
OPENSEA_API_KEY_5=

# Alerts
SALES_PER_MINUTE=5
VOLUME_THRESHOLD_USD=1000
MAX_VOLUME_WINDOW_MINUTES=30

# Supply polling: conservative for Render Free / OpenSea REST
SUPPLY_POLL_SECONDS=30
SUPPLY_ACTIVE_MINUTES=360
MAX_HOT_COLLECTIONS=40

# Collection/stat enrichment
COLLECTION_CACHE_SECONDS=900
STATS_CACHE_SECONDS=120

PORT=10000
VOLUME_ALERT_COOLDOWN_SECONDS=3600
SUPPLY_ALERT_COOLDOWN_SECONDS=1800
